# /etc/scoreforge/scoreforge.env
#
# Copy to that path and edit. Every value here is optional; the defaults are the
# ones shown.

# Address to bind. Leave on loopback. The service has no authentication, so any
# other value exposes it to everything that can reach this machine, and it prints
# a warning at startup if you do.
SCOREFORGE_HOST=127.0.0.1

SCOREFORGE_PORT=8000

# The port the page is served on by scoreforge-web.service, which defaults to
# 8080. Comma separated if you run more than one. The same ports are added to
# the loopback origins allowed to call the API, so a page served here can still
# reach a backend on any port -- set this once and both halves follow.
#
# Ports 8080 and 8081 are always allowed to call the API whatever this says.
#
# The page itself is served from /opt/scoreforge/www, which holds only the built
# file. Set SKIP_WEB=1 at install time if you would rather not run that service.
#SCOREFORGE_WEB_PORT=3000

# Browser origins allowed to call the API beyond the loopback ports above.
# Nothing normally goes here: Chrome reports a page opened off disk as origin
# "file://" (and "null" for other opaque origins), and both are always allowed,
# so double-clicking index.html works with no configuration at all.
#
# Add an origin only if you serve the page from somewhere that is not a loopback
# port -- your own domain, say. The point of listing them is that "*" would let
# any website your browser visits read this service.
#
# The page and the API do not have to share a hostname. For a split such as
#   page  https://music.example.com
#   API   https://api.music.example.com
# set the PAGE's origin here (music.example.com), not the API's, and keep the
# service on loopback behind the proxy.
#SCOREFORGE_ALLOWED_ORIGINS=https://music.example.com

# Host header values the service answers to. This is what stops DNS rebinding.
# Add the API's own hostname if you terminate TLS on a proxy -- TrustedHost
# middleware compares this against the Host header, without the port.
#SCOREFORGE_ALLOWED_HOSTS=api.music.example.com

# Escape hatch if you must accept any Host header. Not recommended: it re-opens
# DNS rebinding, and combined with a non-loopback SCOREFORGE_HOST it also means
# anything on your network can drive the backend.
#SCOREFORGE_ALLOW_ANY_HOST=1